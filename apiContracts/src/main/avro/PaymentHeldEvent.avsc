{
  "type": "record",
  "namespace": "com.deliveryhub.contracts.events",
  "name": "PaymentHeldEvent",
  "fields": [
    {"name": "eventId", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "orderId", "type": "long"},
    {"name": "userId", "type": "long"},
    {"name": "amount", "type": {"type": "bytes", "logicalType": "decimal", "precision": 12, "scale": 2}},
    {"name": "provider", "type": "string"},
    {"name": "heldAt", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "restaurantId", "type": ["null", "long"], "default": null},
    {"name": "restaurantLocation", "type": ["null", "com.deliveryhub.contracts.events.GeoPoint"], "default": null},
    {"name": "deliveryLocation", "type": ["null", "com.deliveryhub.contracts.events.GeoPoint"], "default": null},
    {"name": "deliveryAddress", "type": ["null", "string"], "default": null},
    {"name": "deliveryComment", "type": ["null", "string"], "default": null}
  ]
}
