{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "char_filter": {
        "yo": {"type": "mapping", "mappings": ["ё => е", "Ё => Е"]}
      },
      "filter": {
        "russian_stop": {"type": "stop", "stopwords": "_russian_"},
        "russian_stemmer": {"type": "stemmer", "language": "russian"},
        "edge": {"type": "edge_ngram", "min_gram": 1, "max_gram": 20},
        "ru_en_synonyms": {"type": "synonym_graph", "lenient": true, "synonyms": []}
      },
      "analyzer": {
        "russian_text": {
          "type": "custom",
          "char_filter": ["yo"],
          "tokenizer": "standard",
          "filter": ["lowercase", "russian_stop", "russian_stemmer"]
        },
        "russian_search": {
          "type": "custom",
          "char_filter": ["yo"],
          "tokenizer": "standard",
          "filter": ["lowercase", "ru_en_synonyms", "russian_stop", "russian_stemmer"]
        },
        "autocomplete": {
          "type": "custom",
          "char_filter": ["yo"],
          "tokenizer": "standard",
          "filter": ["lowercase", "edge"]
        },
        "autocomplete_search": {
          "type": "custom",
          "char_filter": ["yo"],
          "tokenizer": "standard",
          "filter": ["lowercase"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "kind": {"type": "keyword"},
      "restaurantId": {"type": "long"},
      "menuItemId": {"type": "long"},
      "name": {
        "type": "text",
        "analyzer": "russian_text", "search_analyzer": "russian_search",
        "fields": {
          "autocomplete": {"type": "text", "analyzer": "autocomplete", "search_analyzer": "autocomplete_search"},
          "raw": {"type": "keyword"}
        }
      },
      "description": {"type": "text", "analyzer": "russian_text", "search_analyzer": "russian_search"},
      "category": {"type": "text", "analyzer": "russian_text", "search_analyzer": "russian_search", "fields": {"raw": {"type": "keyword"}}},
      "restaurantName": {"type": "text", "analyzer": "russian_text", "search_analyzer": "russian_search"},
      "cuisine": {"type": "text", "analyzer": "russian_text", "search_analyzer": "russian_search"},
      "address": {"type": "text", "analyzer": "russian_text", "search_analyzer": "russian_search"},
      "section": {"type": "keyword"},
      "price": {"type": "scaled_float", "scaling_factor": 100},
      "available": {"type": "boolean"},
      "active": {"type": "boolean"},
      "changedAt": {"type": "long"}
    }
  }
}
